<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>goldengen</AssemblyName>
    <!-- 版本升级时随 protocol.gen.json 一并修改；CI 日常只跑 Go 测试，不构建本工具。 -->
    <PacketsVersion>0.9.10</PacketsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MUnique.OpenMU.Network.Packets" Version="$(PacketsVersion)" />
  </ItemGroup>

</Project>
